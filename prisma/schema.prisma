// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Player {
  id Int @id @default(autoincrement())
  nom     String
  prenom  String
  age     Int
  positionId Int
  position   Position @relation(fields: [positionId], references: [id])

  teamId Int
  team   Team @relation(fields: [teamId], references: [id])

  transfers Transfer[]
}

model Position {
  id Int @id @default(autoincrement())
  nom String
  players Player[]
}

model Country {
  id Int @id @default(autoincrement())
  nom String

  teams Team[]
}

model Team {
  id Int @id @default(autoincrement())
  nom String

  countryId Int
  country   Country @relation(fields: [countryId], references: [id])

  players Player[]

  transfersFrom Transfer[] @relation("TransferFromTeam")
  transfersTo   Transfer[] @relation("TransferToTeam")
}

// historique des transferts de joueurs entre équipes
model Transfer {
  id Int @id @default(autoincrement())

  playerId Int
  player   Player @relation(fields: [playerId], references: [id])

  fromTeamId Int
  fromTeam   Team @relation("TransferFromTeam", fields: [fromTeamId], references: [id])

  toTeamId Int
  toTeam   Team @relation("TransferToTeam", fields: [toTeamId], references: [id])

  montant Float
  date    DateTime @default(now())
}
